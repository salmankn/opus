# $0 free-tier env — copy to .env and fill with free-tier values
# Database: Supabase Free or Neon Free Postgres
DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"

# Auth.js (self-hosted, free)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Storage: local dir by default ($0). R2/Supabase when deploying.
# Local:
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage-local"
# Cloud (free tier) — uncomment when ready:
# STORAGE_PROVIDER="s3"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_BUCKET="artifacts-free"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"

# Models — free-first router. At least one free provider; mock works offline.
# Gemini AI Studio (free tier):
# GEMINI_API_KEY=""
# OpenRouter (:free models):
# OPENROUTER_API_KEY=""
# HuggingFace Inference (free):
# HF_TOKEN=""
# Local Ollama fallback (fully free/offline):
OLLAMA_BASE_URL="http://localhost:11434"
MODEL_ROUTER_POLICY="free-first"

# Queue: postgres-backed by default (no Redis bill). Upstash optional.
QUEUE_PROVIDER="pg"
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Free-tier guardrails (required — keeps us inside free quotas)
TASK_MAX_RUNTIME_MS="600000"
TASK_MAX_TOOL_CALLS="50"
TASK_MAX_RETRIES="3"
MODEL_DAILY_TOKEN_BUDGET="100000"
